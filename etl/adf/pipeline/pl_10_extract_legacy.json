{
  "name": "pl_10_extract_legacy",
  "properties": {
    "description": "Extract every enabled legacy object (query from the control DB) to bronze Parquet, partitioned by run_id.",
    "parameters": {
      "run_id": {
        "type": "String"
      }
    },
    "activities": [
      {
        "name": "Lookup objects",
        "type": "Lookup",
        "typeProperties": {
          "source": {
            "type": "AzureSqlSource",
            "sqlReaderQuery": "SELECT object_name, source_query FROM etl.migration_object WHERE enabled = 1 AND source_query IS NOT NULL ORDER BY load_order"
          },
          "dataset": {
            "referenceName": "ds_sql_control",
            "type": "DatasetReference"
          },
          "firstRowOnly": false
        }
      },
      {
        "name": "For each object",
        "type": "ForEach",
        "dependsOn": [
          {
            "activity": "Lookup objects",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ],
        "typeProperties": {
          "items": {
            "value": "@activity('Lookup objects').output.value",
            "type": "Expression"
          },
          "isSequential": false,
          "batchCount": 4,
          "activities": [
            {
              "name": "Copy to bronze",
              "type": "Copy",
              "policy": {
                "timeout": "0.02:00:00",
                "retry": 2
              },
              "inputs": [
                {
                  "referenceName": "ds_legacy_sql_query",
                  "type": "DatasetReference"
                }
              ],
              "outputs": [
                {
                  "referenceName": "ds_adls_parquet",
                  "type": "DatasetReference",
                  "parameters": {
                    "container": "bronze",
                    "folder": {
                      "value": "@concat(item().object_name, '/run_id=', pipeline().parameters.run_id)",
                      "type": "Expression"
                    }
                  }
                }
              ],
              "typeProperties": {
                "source": {
                  "type": "SqlServerSource",
                  "sqlReaderQuery": {
                    "value": "@item().source_query",
                    "type": "Expression"
                  },
                  "queryTimeout": "02:00:00"
                },
                "sink": {
                  "type": "ParquetSink"
                },
                "enableStaging": false
              }
            }
          ]
        }
      },
      {
        "name": "log_extract",
        "type": "SqlServerStoredProcedure",
        "dependsOn": [
          {
            "activity": "For each object",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ],
        "linkedServiceName": {
          "referenceName": "ls_sql_control",
          "type": "LinkedServiceReference"
        },
        "typeProperties": {
          "storedProcedureName": "etl.usp_log_step",
          "storedProcedureParameters": {
            "run_id": {
              "value": "@pipeline().parameters.run_id",
              "type": "String"
            },
            "step": {
              "value": "log_extract",
              "type": "String"
            },
            "status": {
              "value": "EXTRACTED",
              "type": "String"
            },
            "pipeline_run": {
              "value": "@pipeline().RunId",
              "type": "String"
            }
          }
        }
      }
    ]
  }
}
